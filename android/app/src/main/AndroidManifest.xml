<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.daami.app">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application android:label="dami">
        <service android:name="com.daami.damiService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name="com.daami.context.DamiAccessibilityService"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
                 android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                       android:resource="@xml/accessibility_service" />
        </service>
        <activity android:name="com.daami.SettingsActivity" android:exported="true" />
        <activity android:name="com.daami.PerAppSettingsActivity" android:exported="true" />
    </application>
</manifest>
